{
  "name": "solar-ai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm --filter server dev",
    "dev:web": "pnpm --filter web dev",
    "dev:agent": "pnpm --filter voice-agent dev",
    "build": "pnpm -r build",
    "check-types": "pnpm -r check-types",
    "db:push": "pnpm --filter @solar-ai/db db:push",
    "db:studio": "pnpm --filter @solar-ai/db db:studio",
    "db:generate": "pnpm --filter @solar-ai/db db:generate",
    "db:migrate": "pnpm --filter @solar-ai/db db:migrate",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@solar-ai/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@solar-ai/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.5.3"
}
